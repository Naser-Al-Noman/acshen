# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_MAX_OUTPUT_TOKENS=160
CHAT_HISTORY_TURNS=4
# Semantic search on by default (local precomputed vectors, ~1–1.5s).
CHAT_USE_VECTOR_SEARCH=true
# Set false for keyword-only matching (~sub-1s)
# CHAT_USE_VECTOR_SEARCH=false
CHAT_VECTOR_BACKEND=local
# CHAT_VECTOR_BACKEND=supabase
CHAT_MAX_LOCAL_CHUNKS=3

# Hugging Face (optional Gemini quota fallback)
# Create a free token at https://huggingface.co/settings/tokens
# Enable "Make calls to Inference Providers" if prompted
HF_TOKEN=hf_your_token_here
HF_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_MAX_TOKENS=160
HF_HISTORY_TURNS=4
# If HF is slower than this, return a local portfolio snippet instead
HF_TIMEOUT_MS=1200
# true = when Gemini fails but chunks exist, answer instantly (skip HF)
# false/unset = try HF first (default)
HF_SKIP_WHEN_CONTEXT=false

# Supabase (required for ingest / optional vector search)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server
PORT=3000

# Trigger.dev (optional)
# Keep TRIGGER_SECRET_KEY set so the project stays wired, but chat stays sync/snappy
# unless you opt into background jobs:
# CHAT_VIA_TRIGGER=true
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=proj_replace_me
# CHAT_VIA_TRIGGER=false

